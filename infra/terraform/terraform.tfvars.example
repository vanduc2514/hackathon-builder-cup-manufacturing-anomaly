# Copy to terraform.tfvars (gitignored) to override defaults.
# project_id and billing_account_id come from TF_VAR_project_id / TF_VAR_billing_account_id
# in mise.local.toml; name_suffix comes from TF_VAR_name_suffix in mise.toml.

