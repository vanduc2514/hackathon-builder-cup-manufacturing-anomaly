# =============================================================================
# Kaizen Agent — Manufacturing Anomaly Detection
# Monorepo: backend/ (Python/FastAPI) + apps/web, apps/mobile (React/Vite)
# =============================================================================

# -----------------------------------------------------------------------------
# Secrets & Credentials (NEVER commit)
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.p12
*.pfx
*.key
gcp-oauth.keys.json
*oauth*.json
tokens.json
GOOGLE_APPLICATION_CREDENTIALS*.json
service-account*.json
.gcp/

# -----------------------------------------------------------------------------
# Python — backend/
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so

# Distribution / packaging
.Python
build/
dist/
*.egg-info/
*.egg
.eggs/
MANIFEST

# Virtual environments
.venv/
venv/
env/
ENV/

# Testing & coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/

# Type checking
.mypy_cache/
.dmypy.json
.pytype/
.pyre/

# Jupyter / IPython
.ipynb_checkpoints/
*.ipynb

# -----------------------------------------------------------------------------
# Node.js — apps/
# -----------------------------------------------------------------------------
node_modules/
apps/*/node_modules/

# Vite / build output
apps/*/dist/
apps/*/.vite/
apps/*/build/

# npm / yarn / pnpm
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
package-lock.json
yarn.lock

# Firebase CLI cache
.firebase/

# Storybook
.storybook-out/
storybook-static/

# -----------------------------------------------------------------------------
# mise — tool version manager
# -----------------------------------------------------------------------------
# Trust file is local-only; the toml itself IS committed
.mise.trusted

# -----------------------------------------------------------------------------
# Google Cloud / GCP
# -----------------------------------------------------------------------------
# ADC credential file generated by `gcloud auth application-default login`
application_default_credentials.json
.gcloud/

# Terraform state (if infra is added later)
*.tfstate
*.tfstate.*
.terraform/
.terraform.lock.hcl

# -----------------------------------------------------------------------------
# Data & Models (large binary / generated files)
# -----------------------------------------------------------------------------
# Raw sensor / telemetry datasets
data/datasets/ai4i_telemetry/*.csv
data/datasets/mvtec_ad/**/*.png
data/datasets/mvtec_ad/**/*.jpg

# Exported ONNX / GGUF / SafeTensor model weights
*.onnx
*.gguf
*.safetensors
*.bin
*.pt
*.pth

# -----------------------------------------------------------------------------
# Docker
# -----------------------------------------------------------------------------
.docker/
docker-compose.override.yml

