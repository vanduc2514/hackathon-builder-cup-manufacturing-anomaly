---
config:
  layout: elk
  look: neo
---
flowchart TB
    %% ---------- Orchestrator ----------
    ORCH["ORCHESTRATOR AGENT (ADK)<br/>receives every input, opens the incident<br/>sole writer of the board, decides who runs next<br/>publishes every output"]

    %% ---------- Shared blackboard ----------
    BOARD[("SHARED INCIDENT STATE - Firestore blackboard<br/>every message = finding | evidence | confidence | citation")]

    %% ---------- Phase A ----------
    subgraph PHASE_A["Phase A - Detection & Gatekeeper"]
        A1["1. QUALITY INSPECTOR<br/>defect type / location / severity + SPC<br/>classifies defect for the Orchestrator & re-verifies N good products<br/>Gemma edge gateway + Gemini Vision"]
    end

    %% ---------- Phase B ----------
    subgraph PHASE_B["Phase B - Tracing and Root Cause"]
        B1["2. TRACEABILITY<br/>discrete topology & ranked suspects<br/>product to machine / tool / mold / lot / operator<br/>RUNS FIRST - sequential and mandatory<br/>BigQuery + ADK tool"]
        B2["3. PROCESS ANALYST<br/>continuous sensor telemetry & window<br/>vibration / temperature / current vs baseline<br/>BigQuery + Gemini"]
        B3["4. ROOT CAUSE (RCA)<br/>5-Whys + Ishikawa fishbone<br/>synthesizes evidence & queries RAG tool<br/>ranked hypotheses with confidence<br/>Gemini + Vertex AI Search"]
    end

    %% ---------- Phase C ----------
    subgraph PHASE_C["Phase C - Resolution"]
        C1["5. TECHNICIAN COPILOT<br/>live voice + camera, step by step<br/>Phase B diagnostic check & Phase C repair<br/>Gemini Live API"]
        C2["6. INCIDENT SCRIBE<br/>drafts work order / 8D report / SOP proposal<br/>drafts only - human approves<br/>Gemini"]
    end

    %% ---------- Phase D ----------
    subgraph PHASE_D["Phase D - Learning"]
        D1["7. CONTINUOUS LEARNING<br/>expert technician video to procedure<br/>grows defect-cause-fix library & impact card<br/>Gemini Video + BigQuery"]
    end

    %% ---------- Humans ----------
    TECH["TECHNICIAN<br/>phone voice + camera"]
    LEAD["SHIFT LEADER / MANAGER<br/>final decision maker"]

    %% ---------- Only the Orchestrator writes the board; agents return drafts ----------
    ORCH <-->|"sole writer"| BOARD

    %% ---------- Orchestration order ----------
    ORCH -->|"step 0 - classify defect / finding"| A1
    ORCH -->|"step 1 - sequential, mandatory"| B1
    ORCH -->|"step 2 - analyze telemetry window"| B2
    ORCH -->|"step 3 - synthesize root cause"| B3
    ORCH -->|"step 4 - parallel"| C1
    ORCH -->|"step 4 - parallel"| C2
    ORCH -->|"keeps watching until verified"| A1
    ORCH -->|"step 5 - close, learn & impact"| D1

    %% ---------- Evidence-gathering loop ----------
    B3 -.->|"confidence under 0.7 - need field evidence"| ORCH
    ORCH -.->|"dispatches inspection request"| C1

    %% ---------- Product-first closed loop ----------
    A1 -.->|"verified: N consecutive good products"| ORCH

    %% ---------- Human-in-the-loop ----------
    C1 <-->|"live voice + camera stream (only direct human channel)"| TECH
    C1 -.->|"repair done / diagnostic evidence"| ORCH
    C2 -.->|"draft"| ORCH
    ORCH -->|"draft awaiting approval"| LEAD
    LEAD -->|"approval"| ORCH

    %% ---------- Learning feedback loop ----------
    D1 -.->|"knowledge entry + impact draft"| ORCH
    ORCH -->|"new knowledge entry for RCA"| B3

    %% ---------- Styling ----------
    classDef orch fill:#4A148C,stroke:#311B92,color:#FFFFFF
    classDef board fill:#0D47A1,stroke:#0B3D91,color:#FFFFFF
    classDef phaseA fill:#E8F5E9,stroke:#2E7D32,color:#1B5E20
    classDef phaseB fill:#E3F2FD,stroke:#1565C0,color:#0D47A1
    classDef phaseC fill:#FFF3E0,stroke:#EF6C00,color:#E65100
    classDef phaseD fill:#F3E5F5,stroke:#6A1B9A,color:#4A148C
    classDef human fill:#FCE4EC,stroke:#AD1457,color:#880E4F

    class ORCH orch
    class BOARD board
    class A1 phaseA
    class B1,B2,B3 phaseB
    class C1,C2 phaseC
    class D1 phaseD
    class TECH,LEAD human
